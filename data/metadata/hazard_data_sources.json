      "name": "Flood",
      "priority": "very_high",
      "agencies": [
        "NRSC/ISRO",
        "Central Water Commission",
        "India Meteorological Department"
      ],
      "data_requirements": {
        "historical": [
          "flood_extent",
          "flood_depth",
          "historical_flood_events",
          "flood_frequency"
        ],
        "weather": [
          "rainfall_1h",
          "rainfall_6h",
          "rainfall_24h",
          "rainfall_72h",
          "forecast_rainfall"
        ],
        "hydrology": [
          "river_level",
          "river_level_change",
          "river_discharge"
        ],
        "terrain": [
          "elevation",
          "slope",
          "distance_to_river",
          "distance_to_drainage"
        ]
      },
      "ml_target": [
        "flood_next_24h",
        "flood_next_48h"
      ]
    },

    "landslide": {
