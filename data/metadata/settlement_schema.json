{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rakshagrid.local/schema/settlement.json",
  "title": "RakshaGrid Settlement",
  "description": "Canonical settlement input schema for the RakshaGrid risk engine.",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "settlement_id",
    "settlement_name",
    "state",
    "district",
    "hazard_type",
    "latitude",
    "longitude",
    "population",
    "population_density",
    "vulnerability_score"
  ],

  "properties": {

    "settlement_id": {
      "type": "string",
      "minLength": 1
    },

    "settlement_name": {
      "type": "string",
      "minLength": 1
    },

    "state": {
      "type": "string",
      "minLength": 1
    },

    "district": {
      "type": "string",
      "minLength": 1
    },
    "hazard_type": {
         "type": "string",
          "enum": [
            "flood",
            "landslide",
            "forest_fire",
            "earthquake",
            "lightning",
            "cyclone",
            "extreme_rainfall",
            "thunderstorm",
            "heatwave",
            "coldwave",
            "drought",
            "cloudburst",
            "storm_surge",
            "tsunami"
        ]
    },

    "latitude": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },

    "longitude": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },

    "population": {
      "type": "integer",
      "minimum": 0
    },

    "households": {
      "type": "integer",
      "minimum": 0
    },

    "population_density": {
      "type": "number",
      "minimum": 0
    },

    "vulnerability_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },

    "housing_structure": {
      "type": "string"
    },

    "rainfall_mm": {
      "type": "number",
      "minimum": 0
    },

    "river_level_m": {
      "type": "number",
      "minimum": 0
    },

    "danger_level_m": {
      "type": "number",
      "exclusiveMinimum": 0
    },

    "inundation_depth_m": {
      "type": "number",
      "minimum": 0
    },

    "historical_flood_frequency": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },

    "travel_time_minutes": {
      "type": "number",
      "minimum": 0
    },

    "road_accessibility": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },

    "shelter_capacity": {
      "type": "integer",
      "minimum": 0
    }
  }
}